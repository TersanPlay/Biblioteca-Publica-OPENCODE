# Appwrite
APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="6a95dd2d001313fa9653"
APPWRITE_DATABASE_ID="biblioteca"
APPWRITE_API_KEY="crie-uma-api-key-no-console-em-Overview-Integration-API-keys (scopes: databases, users, storage)"

# Bucket de backups no Appwrite Storage (criado pelo `npm run appwrite:setup`)
APPWRITE_BACKUP_BUCKET_ID="biblioteca-backups"

# JWT ainda usado para sessão própria (fallback)
JWT_SECRET=cole-um-segredo-forte-aqui-minimo-32-caracteres

# First admin (Appwrite Auth user)
ADMIN_EMAIL=seu@email.com
ADMIN_PASSWORD=sua-senha-forte

# Frontend permitido no CORS (separar por vírgula)
# CORS_ORIGIN="http://localhost:5173,https://sua-app.vercel.app"
